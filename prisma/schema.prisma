// =============================================================================
// MasaLink — PostgreSQL veri modeli (Prisma)
//
// Tasarım ilkeleri:
// - Her iş tablosunda `tenantId` bulunur ve tüm sorgular tenant kapsamlıdır
//   (ileride PostgreSQL RLS politikaları bu kolon üzerinden yazılacak).
// - Para alanları Decimal(12,2), miktar alanları Decimal(14,3) — float yok.
// - Sipariş kalemleri ürün adı/fiyatını SNAPSHOT olarak saklar; menü fiyatı
//   değişse bile geçmiş adisyonlar bozulmaz.
// - Stok, `Ingredient.currentStock` (hızlı okuma) + `StockMovement` (değişmez
//   defter) ikilisiyle tutulur; ikisi aynı transaction içinde güncellenir.
// - Masa üzerinde `version` alanı optimistic locking içindir
//   (eski in-memory TABLE_VERSIONS Map'inin yerini alır).
// - Bir masada aynı anda yalnızca bir ACTIVE oturum olabilir: bu kural Prisma
//   şemasıyla ifade edilemediği için migration içinde partial unique index
//   olarak tanımlıdır.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum TenantPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum RoleKey {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

enum TableSection {
  SALON
  BAHCE
  TERAS
  BAR
}

enum TableStatus {
  EMPTY
  WAITING_MENU
  PREPARING
  SERVED
  BILL_REQUESTED
  CLEANING
}

enum TableSessionStatus {
  ACTIVE
  CLOSED
  REVOKED
}

enum KitchenStation {
  GRILL
  OVEN
  BAR
  COLD
  NONE
}

enum OrderSource {
  QR
  WAITER
  POS
}

enum OrderStatus {
  PENDING_APPROVAL
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
  COMPED
}

enum PaymentMethod {
  CASH
  CARD
  MEAL_CARD
  ONLINE
  OTHER
}

enum PaymentStatus {
  COMPLETED
  REFUNDED
  VOIDED
}

enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

enum StockUnit {
  GRAM
  MILLILITER
  PIECE
  SLICE
}

enum StockMovementType {
  PURCHASE
  SALE
  WASTE
  ADJUSTMENT
  RETURN
}

// -----------------------------------------------------------------------------
// KİRACI / ŞUBE / KULLANICI
// -----------------------------------------------------------------------------

model Tenant {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  plan        TenantPlan   @default(STARTER)
  status      TenantStatus @default(TRIAL)
  trialEndsAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  branches       Branch[]
  roles          Role[]
  users          User[]
  tables         Table[]
  tableSessions  TableSession[]
  categories     Category[]
  products       Product[]
  productOptions ProductOption[]
  orders         Order[]
  orderItems     OrderItem[]
  payments       Payment[]
  ingredients    Ingredient[]
  recipes        Recipe[]
  stockMovements StockMovement[]
  orderDrafts    OrderDraft[]
  auditLogs      AuditLog[]
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  slug      String
  name      String
  address   String?
  timezone  String   @default("Europe/Istanbul")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]
  tables Table[]
  orders Order[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

/// Kiracı bazlı rol. `permissions` örn: ["discount:approve","order:cancel"].
model Role {
  id          String   @id @default(cuid())
  tenantId    String
  key         RoleKey
  name        String
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, key])
}

/// Panel kullanıcıları e-posta+şifre, saha personeli PIN ile giriş yapar.
/// PIN'ler bcrypt ile hash'lenir (eski düz SHA-256 hash'lerin yerine).
model User {
  id           String        @id @default(cuid())
  tenantId     String
  branchId     String?
  roleId       String
  name         String
  email        String?
  passwordHash String?
  pinHash      String?
  section      TableSection?
  avatar       String?
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  openedSessions   TableSession[]  @relation("SessionOpenedBy")
  assignedSessions TableSession[]  @relation("SessionWaiter")
  createdOrders    Order[]         @relation("OrderCreatedBy")
  approvedOrders   Order[]         @relation("OrderApprovedBy")
  cashierPayments  Payment[]       @relation("PaymentCashier")
  approvedPayments Payment[]       @relation("PaymentApprovedBy")
  stockMovements   StockMovement[]
  orderDrafts      OrderDraft[]
  auditLogs        AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, branchId, isActive])
  @@index([roleId])
}

// -----------------------------------------------------------------------------
// MASA & MASA OTURUMU
// -----------------------------------------------------------------------------

model Table {
  id        String       @id @default(cuid())
  tenantId  String
  branchId  String
  /// İnsan-okunur sabit kod (QR URL'lerinde kullanılır: /r/{tenantSlug}/{code}), örn "tbl-4".
  /// Kiracı içinde benzersizdir; çok şubeli işletmelerde şube öneki kullanılmalı ("kdk-tbl-4").
  code      String
  name      String
  section   TableSection
  capacity  Int          @default(2)
  status    TableStatus  @default(EMPTY)
  /// Optimistic locking: her yazımda +1; istemci beklediği versiyonu gönderir.
  version   Int          @default(1)
  posX      Int?
  posY      Int?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sessions TableSession[]
  orders   Order[]
  drafts   OrderDraft[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId, status])
}

/// Masa açılışından hesap kapanışına kadar olan adisyon dönemi.
/// QR token'ı burada yaşar; hesap kapanınca/hayalet masa sıfırlanınca REVOKED olur.
/// `totalAmount`/`paidAmount` atomik ödeme defteridir (eski ATOMIC_LEDGERS Map'i).
model TableSession {
  id          String             @id @default(cuid())
  tenantId    String
  tableId     String
  /// 128-bit rastgele QR oturum token'ı (mst_...).
  token       String             @unique
  status      TableSessionStatus @default(ACTIVE)
  guestCount  Int?
  totalAmount Decimal            @default(0) @db.Decimal(12, 2)
  paidAmount  Decimal            @default(0) @db.Decimal(12, 2)
  openedById  String?
  waiterId    String?
  openedAt    DateTime           @default(now())
  closedAt    DateTime?
  revokedAt   DateTime?
  closeReason String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table    Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  openedBy User?     @relation("SessionOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  waiter   User?     @relation("SessionWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  orders   Order[]
  payments Payment[]

  @@index([tenantId, status])
  @@index([tableId, status])
}

// -----------------------------------------------------------------------------
// MENÜ
// -----------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId, sortOrder])
}

model Product {
  id          String         @id @default(cuid())
  tenantId    String
  categoryId  String
  /// İstemcilerin gönderdiği sabit ürün kodu (örn "b1"); fiyat sunucuda bu kodla çözülür.
  code        String
  name        String
  description String?
  price       Decimal        @db.Decimal(12, 2)
  imageUrl    String?
  station     KitchenStation @default(NONE)
  isPopular   Boolean        @default(false)
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recipe     Recipe?
  orderItems OrderItem[]

  @@unique([tenantId, code])
  @@index([tenantId, categoryId, isActive])
}

/// Ekstra malzeme / seçenek (Cheddar, Bacon...). Şimdilik kiracı genelinde geçerli.
model ProductOption {
  id         String   @id @default(cuid())
  tenantId   String
  code       String
  name       String
  extraPrice Decimal  @default(0) @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

// -----------------------------------------------------------------------------
// SİPARİŞ & ÖDEME
// -----------------------------------------------------------------------------

model Order {
  id             String      @id @default(cuid())
  tenantId       String
  branchId       String
  tableId        String?
  sessionId      String?
  /// Şube içinde günlük artan, fişe basılan kısa numara.
  orderNumber    Int
  source         OrderSource
  status         OrderStatus @default(PREPARING)
  subtotal       Decimal     @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  customerNote   String?
  guestName      String?
  /// Çift gönderimi (ağ tekrarları, çift tıklama) engellemek için istemci anahtarı.
  idempotencyKey String?
  createdById    String?
  approvedById   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table      Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  session    TableSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdBy  User?         @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?         @relation("OrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items      OrderItem[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([branchId, status, createdAt])
  @@index([sessionId])
}

model OrderItem {
  id           String          @id @default(cuid())
  tenantId     String
  orderId      String
  productId    String?
  /// Snapshot alanları: menü değişse de adisyon değişmez.
  productName  String
  unitPrice    Decimal         @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal         @db.Decimal(12, 2)
  /// [{ code, name, price }]
  extras       Json            @default("[]")
  cookingLevel String?
  note         String?
  guestTag     String?
  station      KitchenStation  @default(NONE)
  status       OrderItemStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]

  @@index([orderId])
  @@index([tenantId, station, status])
  @@index([productId])
}

model Payment {
  id                  String        @id @default(cuid())
  tenantId            String
  sessionId           String
  method              PaymentMethod
  status              PaymentStatus @default(COMPLETED)
  amount              Decimal       @db.Decimal(12, 2)
  discountType        DiscountType  @default(NONE)
  discountValue       Decimal       @default(0) @db.Decimal(12, 2)
  discountReason      String?
  /// İkram/iptal edilen kalemlerin özeti (denetim için).
  compedItems         Json          @default("[]")
  cashierId           String?
  approvedByManagerId String?
  idempotencyKey      String?
  createdAt           DateTime      @default(now())

  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session           TableSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  cashier           User?        @relation("PaymentCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  approvedByManager User?        @relation("PaymentApprovedBy", fields: [approvedByManagerId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([sessionId])
}

// -----------------------------------------------------------------------------
// REÇETE & STOK
// -----------------------------------------------------------------------------

/// Stok tüm hesaplarda TEMEL birimde tutulur (kg → GRAM, lt → MILLILITER).
model Ingredient {
  id                 String    @id @default(cuid())
  tenantId           String
  name               String
  unit               StockUnit
  currentStock       Decimal   @default(0) @db.Decimal(14, 3)
  criticalThreshold  Decimal   @default(0) @db.Decimal(14, 3)
  /// Temel birim başına maliyet (örn. 1 GRAM'ın TL karşılığı).
  costPerUnit        Decimal   @default(0) @db.Decimal(12, 4)
  wasteFactorPercent Decimal   @default(0) @db.Decimal(5, 2)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipeItems RecipeItem[]
  movements   StockMovement[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model Recipe {
  id        String   @id @default(cuid())
  tenantId  String
  productId String   @unique
  /// Reçetenin ürettiği porsiyon sayısı (genelde 1).
  yield     Decimal  @default(1) @db.Decimal(10, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   RecipeItem[]

  @@index([tenantId])
}

model RecipeItem {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  /// Ingredient.unit cinsinden net miktar.
  netAmount    Decimal @db.Decimal(14, 3)
  wastePercent Decimal @default(0) @db.Decimal(5, 2)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
}

/// Değişmez stok defteri. `quantity` işaretlidir: giriş (+), çıkış (−).
model StockMovement {
  id           String            @id @default(cuid())
  tenantId     String
  ingredientId String
  type         StockMovementType
  quantity     Decimal           @db.Decimal(14, 3)
  /// Hareket sonrası stok (denetim/raporlama kolaylığı).
  balanceAfter Decimal           @db.Decimal(14, 3)
  unitCost     Decimal?          @db.Decimal(12, 4)
  orderItemId  String?
  userId       String?
  reason       String?
  createdAt    DateTime          @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  orderItem  OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([ingredientId, createdAt])
  @@index([orderItemId])
}

// -----------------------------------------------------------------------------
// OPERASYONEL KALICILIK
// -----------------------------------------------------------------------------

/// Garsonun yarım kalan sepeti (eski SERVER_DRAFTS_MAP'in yerini alır).
/// Garson başına tek aktif taslak.
model OrderDraft {
  id          String   @id @default(cuid())
  tenantId    String
  waiterId    String   @unique
  tableId     String
  cart        Json
  itemCount   Int      @default(0)
  totalAmount Decimal  @default(0) @db.Decimal(12, 2)
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waiter User   @relation(fields: [waiterId], references: [id], onDelete: Cascade)
  table  Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresAt])
}

/// İndirim/ikram onayları, iptaller, oturum iptalleri vb. için denetim günlüğü
/// (eski DISCOUNT_AUDIT_LOGS dizisinin yerini alır).
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
}
