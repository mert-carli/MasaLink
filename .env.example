# =============================================================================
# MASALINK RESTORAN YÖNETİM SİSTEMİ — ÇEVRE DEĞİŞKENLERİ ŞABLONU (.env.example)
# =============================================================================
# ⚠️ GÜVENLİK UYARISI:
# Bu dosyayı `.env` olarak kopyalayarak gerçek değerlerle doldurun.
# Gerçek gizli anahtarları KESİNLİKLE Git deposuna veya loglara kaydetmeyin!
# =============================================================================

# 1. ÇALIŞMA ORTAMI (Runtime Environment)
# 'development' | 'test' | 'staging' | 'production'
NODE_ENV="development"
PORT=3000
HOSTNAME="0.0.0.0"

# 2. VERİTABANI BAĞLANTISI (PostgreSQL 15+)
# Üretim ortamında SSL modu zorunludur: sslmode=require
DATABASE_URL="postgresql://masalink:YOUR_DB_PASSWORD@localhost:5432/masalink?schema=public&sslmode=prefer"

# 3. ŞİFRELEME VE OTURUM İMZALAMA ANAHTARLARI (Cryptographic Secrets)
# Üretimde en az 32 byte (64 hex karakter) rastgele entropi zorunludur.
# Üretmek için terminalde: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASALINK_JWT_SECRET="generate_at_least_32_character_random_hex_string_here"
MASALINK_INTERNAL_SYNC_KEY="generate_at_least_32_character_random_hex_string_here"

# 4. YEREL DONANIM YAZDIRMA KÖPRÜSÜ (POS Thermal Receipt Printer Bridge)
# Kasa terminalindeki print bridge servisi ile iletişim için en az 16 karakter:
BRIDGE_SECRET="generate_16_char_secret_key"
PRINT_BRIDGE_URL="https://127.0.0.1:28443/print"

# 5. DAĞITIK KİLİT VE ÖN BELLEK (Upstash Redis)
# Çoklu sunucu/pod yarış durumlarını önlemek için Redis SETNX kilitleri:
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# 6. ÇEVRİMİÇİ ÖDEME SAĞLAYICILARI (Online Payment Gateways)
DEFAULT_PAYMENT_PROVIDER="IYZICO"

# Iyzico Sanal POS API
IYZICO_API_KEY="sandbox-or-prod-api-key"
IYZICO_SECRET_KEY="sandbox-or-prod-secret-key"
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# PayTR Sanal POS iFrame API
PAYTR_MERCHANT_ID="your_merchant_id"
PAYTR_MERCHANT_KEY="your_merchant_key"
PAYTR_MERCHANT_SALT="your_merchant_salt"

# 7. GÖZLEMLENEBİLİRLİK VE LOGLAMA (Observability & Logging)
# 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL="info"

# 8. İLK BAŞLANGIÇ TOHUMLAMA (Yalnızca Geliştirme İçin)
# Üretim modunda bu değişken dikkate alınmaz!
SEED_ADMIN_PASSWORD="CHANGE_ME_IN_DEV_ONLY"
